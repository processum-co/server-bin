# ==============================================================================
# Processum Server — Plantilla de Variables de Entorno de Produccion
# ==============================================================================

# Servidor HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
PREFIX_ROUTE=
LOG_LEVEL=info

# Seguridad y Autenticacion
# Clave secreta para firma de tokens JWT (minimo 32 caracteres)
JWT_SECRET=supersecret_enterprise_jwt_token_change_in_production_min32chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*

# Motor de Base de Datos
# Opciones soportadas: memory | sqlserver | postgresql
DATABASE_ENGINE=memory

# Configuracion Microsoft SQL Server (requerido si DATABASE_ENGINE=sqlserver)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrongPassword!
SQLSERVER_DATABASE=processum_judicial
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Configuracion PostgreSQL (requerido si DATABASE_ENGINE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=processum_judicial
POSTGRES_SSL=false
